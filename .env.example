# Copie para .env (não versionado) e preencha os valores.

# --- Supabase: CLIENT (navegador) ---
# A anon key é pública por design (protegida por RLS). Prefixo VITE_ = vai pro bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase: SERVIDOR (funções em api/) ---
# NUNCA use prefixo VITE_ aqui: a service_role bypassa RLS e não pode ir pro browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n webhook ---
# Segredo compartilhado entre o n8n e api/messages/inbound.ts.
# Enviado no header x-webhook-secret; comparado em tempo constante (401 se não bater).
N8N_WEBHOOK_SECRET=

# --- Backend legado opcional (camada Axios em src/services/api.ts) ---
# Vazio = modo mock em localStorage. Provavelmente não usado (dados vêm do Supabase).
VITE_API_URL=
