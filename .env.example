# Copie para .env (não versionado) e preencha os valores.

# --- Supabase: CLIENT (navegador) ---
# A anon key é pública por design (protegida por RLS). Prefixo VITE_ = vai pro bundle.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Supabase: SERVIDOR (funções em api/) ---
# NUNCA use prefixo VITE_ aqui: a service_role bypassa RLS e não pode ir pro browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- n8n: mensagens RECEBIDAS (n8n -> app) ---
# Segredo compartilhado entre o n8n e api/messages/inbound.ts.
# Enviado no header x-webhook-secret; comparado em tempo constante (401 se não bater).
# Usado tanto pelo workflow que registra respostas de paciente quanto pelo que
# confirma o envio de um disparo (ver N8N_SEND_WEBHOOK_* abaixo).
N8N_WEBHOOK_SECRET=

# --- n8n: disparo de formulário (app -> n8n) ---
# URL do webhook do n8n que recebe { patients: [...] } e aciona o envio via
# WhatsApp. Ver api/messages/send-form.ts.
N8N_SEND_WEBHOOK_URL=
# Segredo enviado no header x-webhook-secret dessa chamada — direção oposta ao
# N8N_WEBHOOK_SECRET acima (não precisa ser o mesmo valor, mas pode ser).
N8N_SEND_WEBHOOK_SECRET=

# --- URL pública do app ---
# Usada por api/messages/send-form.ts para montar o link do formulário
# (https://<PUBLIC_APP_URL>/formulario/:token) mandado pro paciente.
PUBLIC_APP_URL=

# --- Backend legado opcional (camada Axios em src/services/api.ts) ---
# Vazio = modo mock em localStorage. Provavelmente não usado (dados vêm do Supabase).
VITE_API_URL=